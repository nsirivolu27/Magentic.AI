{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "llm/**/*.ts",
    "catalog/**/*.ts",
    "tests/**/*.ts",
    "workbench/**/*.ts",
    "workbench/**/*.tsx"
  ]
}
