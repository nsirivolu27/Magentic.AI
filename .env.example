# The relay this adapter talks to. Required; the server refuses to start
# without both of these rather than failing on its first call.
LNKZ_BASE_URL=http://127.0.0.1:3100
LNKZ_API_KEY=replace-with-a-dedicated-relay-key

# Which tools to expose. Omit for everything, which is the default and what
# every existing deployment already has. Set to "read" to hide the tools that
# change things: saving, importing, appending, deleting, minting, redeeming,
# continuing and revoking.
#
# This controls what a model can see, not what it is permitted to do. The
# relay enforces the key's real scopes and will refuse a write on a read-only
# key whatever is registered here.
# LNKZ_MCP_SCOPES=read

# ---------------------------------------------------------------------------
# Language model retrieval. Off unless you set a provider.
#
# With a provider set, the adapter gains two read-only tools, semantic_search
# and ask_conversations, which rank conversation passages by meaning and
# answer questions from them with citations. Leaving this unset registers
# neither tool, so a model never proposes using one.
#
# Turning this on means conversation text leaves this instance for whichever
# provider you name. For a relay whose premise is that conversations stay
# where they are, "ollama" against a server you run keeps that true; "openai"
# does not.
#
# The @langchain package for your provider is an optional peer dependency and
# is not installed by default:
#   pnpm add @langchain/ollama      # or @langchain/openai
#
# LNKZ_LLM_PROVIDER=ollama
# LNKZ_LLM_BASE_URL=http://127.0.0.1:11434
# LNKZ_LLM_CHAT_MODEL=llama3.1
# LNKZ_LLM_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_API_KEY=                        # required only when the provider is openai

# Cost ceilings. Every one of these bounds a single query, so the worst case
# is knowable before you turn the feature on. Values out of range are clamped
# rather than rejected.
# LNKZ_LLM_MAX_CONVERSATIONS=40          # conversations pulled and ranked per query
# LNKZ_LLM_MAX_CHUNKS=12                 # passages kept after ranking
# LNKZ_LLM_CHUNK_CHARS=1600              # characters per passage
# LNKZ_LLM_BATCH_SIZE=64                 # passages per embedding request
# LNKZ_LLM_MAX_CONTEXT_CHARS=24000       # grounding text handed to the chat model
# LNKZ_LLM_CACHE_SIZE=4000               # embedding vectors cached in this process

# ---------------------------------------------------------------------------
# Agents, when hosting. Each definition in this directory becomes its own MCP
# endpoint at /mcp/<name>, exposing only the tools it declares. The catalog is
# readable without a key at /agents, and browsable at /.
#
# Unset, only /mcp exists, which is what every deployment before agents had.
# Set and wrong, the server refuses to start rather than serving a catalog
# with a hole in it.
#
# A definition is configuration and nothing else: no relay, no key, no code.
# It cannot widen what this deployment allows, so LNKZ_MCP_SCOPES=read above
# turns every agent read-only however its scopes are written.
# LNKZ_AGENTS_DIR=agents
