# The relay this adapter talks to. Required; the server refuses to start
# without both of these rather than failing on its first call.
LNKZ_BASE_URL=http://127.0.0.1:3100
LNKZ_API_KEY=replace-with-a-dedicated-relay-key

# Which tools to expose. Omit for everything, which is the default and what
# every existing deployment already has. Set to "read" to hide the tools that
# change things: saving, importing, appending, deleting, minting, redeeming,
# continuing and revoking.
#
# This controls what a model can see, not what it is permitted to do. The
# relay enforces the key's real scopes and will refuse a write on a read-only
# key whatever is registered here.
# MAGENTIC_SCOPES=read

# ---------------------------------------------------------------------------
# Language model retrieval. Off unless you set a provider.
#
# With a provider set, the adapter gains two read-only tools, semantic_search
# and ask_conversations, which rank conversation passages by meaning and
# answer questions from them with citations. Leaving this unset registers
# neither tool, so a model never proposes using one.
#
# Turning this on means conversation text leaves this instance for whichever
# provider you name. For a relay whose premise is that conversations stay
# where they are, "ollama" against a server you run keeps that true; "openai"
# does not.
#
# The @langchain package for your provider is an optional peer dependency and
# is not installed by default:
#   pnpm add @langchain/ollama      # or @langchain/openai
#
# Providers: openai, ollama, azure, google.
#
# azure and google exist because a deployment often has credits on one cloud
# and not another, and because the choice of provider should not change which
# tools this server exposes. It does not: the same two read-only tools appear
# whichever is set.
#
# Each needs its own package and key:
#   ollama  pnpm add @langchain/ollama
#   openai  pnpm add @langchain/openai        OPENAI_API_KEY
#   azure   pnpm add @langchain/openai        AZURE_OPENAI_API_KEY, AZURE_OPENAI_INSTANCE
#   google  pnpm add @langchain/google-genai  GOOGLE_API_KEY
#
# On Azure the model names above are DEPLOYMENT names, not model names. A
# wrong deployment name is the usual first failure.
# AZURE_OPENAI_INSTANCE=                 # first label of <name>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21    # optional, defaults to this
# GOOGLE_API_KEY=
# MAGENTIC_LLM_PROVIDER=ollama
# MAGENTIC_LLM_BASE_URL=http://127.0.0.1:11434
# MAGENTIC_LLM_CHAT_MODEL=llama3.1
# MAGENTIC_LLM_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_API_KEY=                        # required only when the provider is openai

# Cost ceilings. Every one of these bounds a single query, so the worst case
# is knowable before you turn the feature on. Values out of range are clamped
# rather than rejected.
# MAGENTIC_LLM_MAX_CONVERSATIONS=40          # conversations pulled and ranked per query
# MAGENTIC_LLM_MAX_CHUNKS=12                 # passages kept after ranking
# MAGENTIC_LLM_CHUNK_CHARS=1600              # characters per passage
# MAGENTIC_LLM_BATCH_SIZE=64                 # passages per embedding request
# MAGENTIC_LLM_MAX_CONTEXT_CHARS=24000       # grounding text handed to the chat model
# MAGENTIC_LLM_CACHE_SIZE=4000               # embedding vectors cached in this process

# ---------------------------------------------------------------------------
# Agents, when hosting. Each definition in this directory becomes its own MCP
# endpoint at /mcp/<name>, exposing only the tools it declares. The catalog is
# readable without a key at /agents, and browsable at /.
#
# Unset, only /mcp exists, which is what every deployment before agents had.
# Set and wrong, the server refuses to start rather than serving a catalog
# with a hole in it.
#
# A definition is configuration and nothing else: no relay, no key, no code.
# It cannot widen what this deployment allows, so MAGENTIC_SCOPES=read above
# turns every agent read-only however its scopes are written.
# MAGENTIC_AGENTS_DIR=agents

# ---------------------------------------------------------------------------
# Workspace mode. Off unless a registry directory is named, and off is every
# deployment that exists today: definitions come from agents/*.json and a
# person editing a file is the only approver.
#
# Named, the catalog comes from the registry instead, where a definition is
# served only once it is approved and the signatures still match its content.
# Editing an approved definition changes its hash and stops it being served,
# which is the property that lets people author at runtime without anything
# reaching a client unreviewed.
#
# A registry with no workspace named refuses to start. Serving every
# workspace's agents at one endpoint is the outcome the boundary exists to
# prevent, so there is no safe default to guess.
# MAGENTIC_REGISTRY_DIR=./registry-data
# MAGENTIC_WORKSPACE=agency-a

# Signatures a record needs before it is served. Two is the realistic federal
# default, because one person approving their own work is not review. One is
# the default here only so that turning workspace mode on does not require
# arranging a second approver first.
# MAGENTIC_REQUIRED_APPROVALS=2
