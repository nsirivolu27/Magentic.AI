{
  "name": "magentic-mcp",
  "version": "0.2.0",
  "description": "Magentic: the Model Context Protocol server for the LNKZ conversation relay.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "bin": {
    "magentic": "dist/stdio.mjs",
    "magentic-mcp": "dist/stdio.mjs"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/stdio.mjs",
    "start:http": "node --enable-source-maps ./dist/http-main.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .testbuild/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agents": "node ./dist/list.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@langchain/openai": "^0.6.0",
    "@langchain/ollama": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@langchain/openai": {
      "optional": true
    },
    "@langchain/ollama": {
      "optional": true
    }
  }
}
